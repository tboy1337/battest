{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tboy1337/battest/schema/battest-expect.schema.json",
  "title": "battest fixture document",
  "type": "object",
  "required": ["description", "expect"],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "script": { "$ref": "#/$defs/relativeFixturePath" },
    "args": { "type": "array", "items": { "$ref": "#/$defs/argToken" } },
    "stdin": { "type": "string" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "setup": { "$ref": "#/$defs/relativeFixturePath" },
    "teardown": { "$ref": "#/$defs/relativeFixturePath" },
    "copy": { "type": "array", "items": { "$ref": "#/$defs/relativeFixturePath" } },
    "allow": { "type": "array", "items": { "$ref": "#/$defs/commandName" } },
    "mocks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/commandName" },
      "additionalProperties": { "$ref": "#/$defs/mockSpec" }
    },
    "expect": { "$ref": "#/$defs/expect" },
    "params": {
      "type": "array",
      "items": { "$ref": "#/$defs/paramOverlay" }
    }
  },
  "$defs": {
    "commandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$",
      "not": {
        "pattern": "^(con|prn|aux|nul|clock\\$|conin\\$|conout\\$|com[1-9]|lpt[1-9])(\\..*)?$"
      }
    },
    "relativeFixturePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "^[\\\\/]" },
          { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" },
          {
            "pattern": "(^|[\\\\/])([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(\\.[^\\\\/]*)?([\\\\/]|$)"
          }
        ]
      }
    },
    "newlineMode": { "type": "string", "enum": ["auto", "crlf", "lf"] },
    "argToken": {
      "type": "string",
      "pattern": "^[^\"&|<>^\\r\\n]*$"
    },
    "outputMatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equals": { "type": "string" },
        "equals_file": { "$ref": "#/$defs/relativeFixturePath" },
        "contains": { "type": "string", "minLength": 1 },
        "regex": { "type": "string", "maxLength": 512, "description": "Runtime Pydantic also rejects nested-quantifier and quantified-alternation ReDoS shapes; JSON Schema only bounds length." },
        "empty": { "type": "boolean" },
        "newline": { "$ref": "#/$defs/newlineMode" }
      }
    },
    "fileMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/relativeFixturePath" },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
            }
          ]
        },
        "exists": { "type": "boolean" },
        "not_exists": { "type": "boolean" },
        "contains": { "type": "string", "minLength": 1 },
        "equals": { "type": "string" },
        "equals_file": { "$ref": "#/$defs/relativeFixturePath" },
        "encoding": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "newline": { "$ref": "#/$defs/newlineMode" }
      },
      "anyOf": [
        { "required": ["exists"] },
        { "required": ["not_exists"] },
        { "required": ["contains"] },
        { "required": ["equals"] },
        { "required": ["equals_file"] }
      ],
      "not": {
        "anyOf": [
          {
            "required": ["exists", "not_exists"],
            "properties": {
              "exists": { "const": true },
              "not_exists": { "const": true }
            }
          },
          {
            "required": ["not_exists"],
            "properties": {
              "not_exists": { "const": false }
            }
          },
          {
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": ["exists"],
                    "properties": { "exists": { "const": false } }
                  },
                  {
                    "required": ["not_exists"],
                    "properties": { "not_exists": { "const": true } }
                  }
                ]
              },
              {
                "anyOf": [
                  { "required": ["contains"] },
                  { "required": ["equals"] },
                  { "required": ["equals_file"] }
                ]
              }
            ]
          }
        ]
      }
    },
    "envExpect": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "unset": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": { "type": "string" }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": { "type": "integer" },
        "stdout": { "$ref": "#/$defs/outputMatcher" },
        "stderr": { "$ref": "#/$defs/outputMatcher" },
        "env": { "$ref": "#/$defs/envExpect" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileMatcher" }
        }
      }
    },
    "callExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args_contains": { "type": "string", "minLength": 1 },
        "not_called": { "const": true }
      },
      "anyOf": [
        { "required": ["args_contains"] },
        { "required": ["not_called"] }
      ],
      "not": {
        "required": ["args_contains", "not_called"]
      }
    },
    "mockSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "record_calls": { "type": "boolean" },
        "expect_calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/callExpectation" }
        }
      },
      "if": {
        "properties": {
          "expect_calls": { "type": "array", "minItems": 1 }
        },
        "required": ["expect_calls"]
      },
      "then": {
        "not": {
          "properties": { "record_calls": { "const": false } },
          "required": ["record_calls"]
        }
      }
    },
    "paramOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "$ref": "#/$defs/argToken" } },
        "stdin": { "type": "string" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "mocks": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/commandName" },
          "additionalProperties": { "$ref": "#/$defs/mockSpec" }
        },
        "expect": { "$ref": "#/$defs/expect" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "allow": { "type": "array", "items": { "$ref": "#/$defs/commandName" } }
      }
    }
  }
}
